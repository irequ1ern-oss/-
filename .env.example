# Exact origin serving the account UI and API. HTTP is accepted only on loopback.
REQUIEM_ORIGIN=http://127.0.0.1:8080
REQUIEM_DB=var/requiem.sqlite3
# Optional. A server-side allowlist is required for each provider.
SHAY_PROVIDER=openai
SHAY_OPENAI_KEY=
SHAY_OPENAI_MODELS=
SHAY_GEMINI_KEY=
SHAY_GEMINI_MODELS=
SHAY_OPENROUTER_KEY=
SHAY_OPENROUTER_MODELS=
SHAY_MONTHLY_TOKENS=200000
# Optional licensed JSON schedule, in the same format as the private trip import.
TRANSIT_FEED_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
OBSIDIAN_OWNER=
OBSIDIAN_REPO=
OBSIDIAN_REF=HEAD
OBSIDIAN_PREFIX=
OBSIDIAN_TOKEN=
BRAVE_SEARCH_KEY=
# Optional single-use owner enrollment. Generate a random value, minimum 32 characters.
REQUIEM_ACTIVATION_CODE=
REQUIEM_FIRST_ROUTE=
